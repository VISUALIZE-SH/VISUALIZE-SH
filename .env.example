# Public Zoho Campaigns signup form URL (safe to expose in the client bundle).
VITE_NEWSLETTER_SIGNUP_URL=

# CI supplies the private watchlist through this secret. For local runs, leave
# this empty and maintain artifacts/research/source-registry.yaml instead.
NEWS_SOURCE_REGISTRY_YAML=

# Optional local override for the private weekly research watchlist. The default
# is the ignored artifacts/research/source-registry.yaml path.
RESEARCH_SOURCE_REGISTRY_PATH=
