 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "wall": {
   "label": "LEFT VENTRICULAR CAVITY",
   "body": "The representative wall has a basal inlet toward the mitral junction and a prepared apical opening for this lesson. It is not untreated native anatomy.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "inflow": {
   "label": "APICAL INFLOW",
   "body": "The short inflow segment enters the cavity through a representative apical opening.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.inflow"
  },
  "pump": {
   "label": "GENERIC PUMP HOUSING",
   "body": "The housing marks the pump location. No specific rotor, motor, controller or product design is represented.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.pump"
  },
  "outflow": {
   "label": "OUTFLOW GRAFT",
   "body": "The graft runs outside the chamber to the illustrated ascending artery. Arrows, flow rates and pressure effects are intentionally absent.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.outflow"
  },
  "region_LV": {
   "label": "LEFT VENTRICLE",
   "body": "The front of the left ventricle is cut away to show its cavity. The mitral inlet from the left atrium sits at the top of the cavity, and the apical opening sits at the tip.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_LA": {
   "label": "LEFT ATRIUM",
   "body": "The left atrium sits behind and above the left ventricle and fills it through the mitral inlet.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_AO": {
   "label": "ASCENDING AORTA",
   "body": "The aorta leaves the left ventricle and rises in front of the atria. The graft joins its front wall; the joining point is representative.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_RV": {
   "label": "RIGHT VENTRICLE",
   "body": "The right ventricle lies in front of and to the right of the left ventricle. The graft passes in front of it on the way to the aorta.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_inflow": {
   "label": "INFLOW IN THE APEX",
   "body": "The short inflow tube passes through the apical opening into the left ventricular cavity. Its depth and angle are representative and are not measured on a specific patient or population.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.inflow"
  },
  "region_pump": {
   "label": "GENERIC PUMP HOUSING",
   "body": "The housing sits against the outside of the apex. No specific rotor, motor, controller or product design is represented.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.pump"
  },
  "region_outflow": {
   "label": "OUTFLOW GRAFT",
   "body": "The graft runs outside the heart from the pump to the ascending aorta. Its course is representative and is not measured on a specific patient or population.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "durable-mcs.outflow"
  }
 },
