 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "wall": {
   "label": "REPRESENTATIVE OUTER ENVELOPE",
   "body": "The smooth ventricular envelope represents the outside of the heart. It is not a blood-pool cast or measured epicardium.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "mesh": {
   "label": "EXTERNAL RESTRAINT MESH",
   "body": "A generic network sits outside the representative ventricular surface. Material stiffness and constraint are not computed.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "epicardial-restraint.mesh"
  },
  "rim": {
   "label": "BASAL OPENING",
   "body": "The envelope is open at its base. The illustrated rim distinguishes the exterior mesh from an intracavitary implant.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "epicardial-restraint.rim"
  },
  "region_LV": {
   "label": "LEFT VENTRICLE",
   "body": "The mesh lies over the outside of the left ventricle, up to the apex.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_RV": {
   "label": "RIGHT VENTRICLE",
   "body": "The mesh also covers the outside of the right ventricle, bridging the groove between the two ventricles.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_LA": {
   "label": "LEFT ATRIUM",
   "body": "The left atrium sits above the basal opening of the mesh, outside it.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_RA": {
   "label": "RIGHT ATRIUM",
   "body": "The right atrium sits above the basal opening of the mesh, outside it.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_AO": {
   "label": "AORTA",
   "body": "The aorta rises from the base of the heart, above the mesh.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_PA": {
   "label": "PULMONARY ARTERY",
   "body": "The pulmonary artery rises in front of the aorta, above the mesh.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_mesh": {
   "label": "EXTERNAL RESTRAINT MESH",
