   "fidelity": "authored-schematic",
   "landmarkId": "hf-pressure-sensors.anchor"
  },
  "region_trunk": {
   "label": "PULMONARY TRUNK",
   "body": "The main pulmonary artery leaves the right ventricle through the pulmonary valve opening and rises toward its branches.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_branch": {
   "label": "RIGHT PULMONARY ARTERY",
   "body": "The right branch runs behind the aorta toward the right lung. It gives context for the branch that holds the sensor.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_target": {
   "label": "LEFT PULMONARY ARTERY",
   "body": "The left branch arches backward toward the left lung. In this example the sensor sits in it, beyond the division of the trunk.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_RV": {
   "label": "RIGHT VENTRICLE",
