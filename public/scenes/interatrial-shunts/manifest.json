 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "wall": {
   "label": "SEPTAL TISSUE",
   "body": "The thick wall separates the two sides. Its shape and thickness are representative.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "channel": {
   "label": "PRESERVED CHANNEL",
   "body": "The central lumen remains open through the illustrated device. No flow direction, pressure effect or clinical response is represented.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "flare": {
   "label": "FLARED ENDS",
   "body": "The generic flared ends lie on opposing faces of the representative septum, around an open channel.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "compact": {
   "label": "COMPACT POSE",
   "body": "The narrow illustration contrasts with the expanded pose; a sheath and delivery sequence are omitted.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "region_RA": {
   "label": "RIGHT ATRIUM",
   "body": "The right atrium is opened from the front. The two caval veins open into it above and below the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_LA": {
   "label": "LEFT ATRIUM",
   "body": "The left atrium lies behind the septum. Its back wall carries the openings of the lung veins.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_SVC": {
   "label": "UPPER CAVAL VEIN",
   "body": "The upper caval vein opens into the top of the right atrium, above the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_IVC": {
   "label": "LOWER CAVAL VEIN",
   "body": "The lower caval vein opens into the bottom of the right atrium, below the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_septum": {
   "label": "INTERATRIAL SEPTUM",
   "body": "The cut edge shows the thin wall shared by the two atria. Around it, the atrial walls fold away from each other, so the flat part of the septum is limited.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_communication": {
   "label": "CHANNEL SITE",
   "body": "A round opening through the septum, placed where the oval fossa would lie. The position of the opening is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_device": {
   "label": "GENERIC OPEN SHUNT",
   "body": "The generic device sits in the opening, with a flared end on each face of the septum and an open channel through its middle. Its shape and size are representative and do not represent a specific product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  }
 },
