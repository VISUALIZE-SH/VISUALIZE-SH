 "annotations": {
  "appendage": {
   "label": "APPENDAGE",
   "body": "A pouch arising from the left atrium. It is drawn larger than the source anatomy so the device relationship is easy to see.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "pouch": {
   "label": "REPRESENTATIVE APPENDAGE",
   "body": "The far wall of the representative thick-walled appendage, built from the same smooth profile. This local display shell is separate from the source cast and is not measured anatomy.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "opening": {
   "label": "OPENING",
   "body": "The open ostium of the representative appendage. Its surrounding rim is representative, while the near-half cut in the section is a display aid.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "frame": {
   "label": "CAGE IN PLACE",
   "body": "A self-expanding frame placed inside the appendage, reached from within the heart.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "cover": {
   "label": "COVERED FACE",
   "body": "A fabric membrane on the end that faces the atrium. It spans the opening of the appendage from inside it.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "shoulder": {
   "label": "SHOULDER ON THE WALL",
   "body": "The self-expanding frame pushes outward, so its widest part presses against the wall just inside the opening.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "hooks": {
   "label": "ANCHORS",
   "body": "Small anchors on the outer frame engage the wall and help hold the device in place. Their number here is representative.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "distal": {
   "label": "CLOSED END",
   "body": "The frame closes at its far end, inside the pouch. The lobes beyond it are left unfilled.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "lobe": {
   "label": "LOBE IN THE NECK",
   "body": "The lobe sits a short way inside the appendage, where its outward force holds it against the wall.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "lobehooks": {
   "label": "STABILIZING HOOKS",
   "body": "Hooks or barbs on the lobe add grip against the wall. Their number here is representative.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "waist": {
   "label": "WAIST",
   "body": "A narrow connection between the lobe and the disc, which lets the disc sit on the atrial side while the lobe stays in the neck.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "disc": {
   "label": "DISC OVER THE OPENING",
   "body": "A disc larger than the lobe covers the opening from the atrial side.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "rim": {
   "label": "DISC EDGE",
   "body": "The edge of the disc rests on the atrial wall around the opening. The contact shown is representative.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  }
 },
