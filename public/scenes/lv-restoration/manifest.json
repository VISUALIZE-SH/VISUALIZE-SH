 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "wall": {
   "label": "REPRESENTATIVE VENTRICULAR WALL",
   "body": "A smooth sectional chamber is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "anchor": {
   "label": "PAIRED ANCHORS",
   "body": "Two generic fixation elements mark the ends of a connecting element.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "lv-restoration.anchor"
  },
  "link": {
   "label": "CONNECTING ELEMENT",
   "body": "A shorter representative span brings the two anchored walls inward. This is a posed comparison, not tissue simulation.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "lv-restoration.link"
  },
  "region_LV": {
   "label": "LEFT VENTRICLE",
   "body": "The near part of the left ventricle is cut away to show its cavity. In the cinched pose the walls near the anchors are drawn inward; elsewhere the chamber is unchanged.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_septum": {
   "label": "VENTRICULAR SEPTUM",
   "body": "The septum is the shared wall between the two ventricles. One anchor rests on its right ventricular side.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_RV": {
   "label": "RIGHT VENTRICLE",
   "body": "The right ventricle wraps around the septum. Its near wall is cut away to show the septal anchor.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_anchor": {
   "label": "PAIRED ANCHORS",
   "body": "One generic anchor sits on the outside of the left ventricular wall and the other on the septum, facing the right ventricle. Their positions are representative.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "lv-restoration.anchor"
  },
  "region_link": {
   "label": "CONNECTING ELEMENT",
   "body": "The element crosses the left ventricular cavity between the anchors. Shortening it draws the two walls toward each other; this is a posed comparison, not tissue simulation.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "lv-restoration.link"
  }
 },
