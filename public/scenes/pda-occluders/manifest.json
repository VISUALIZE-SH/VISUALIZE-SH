 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "aorta": {
   "label": "DESCENDING AORTA",
   "body": "The rose-colored parent lumen is a representative descending-aortic cutaway.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic",
   "landmarkId": "pda-occluders.aorta"
  },
  "pulmonary": {
   "label": "PULMONARY ARTERY",
   "body": "The green parent lumen is a representative pulmonary-arterial cutaway.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "duct": {
   "label": "DUCTAL CONNECTION",
   "body": "A short vascular channel joins the two parent lumens. This is outside the cardiac septa; the near walls are removed to show the inside.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic",
   "landmarkId": "pda-occluders.duct"
  },
  "plug": {
   "label": "EXPANDED PLUG",
   "body": "The generic plug occupies the ductal channel; an aortic-side retention rim is shown. No residual flow or sealing is calculated.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "compact": {
   "label": "COMPACT POSE",
   "body": "The narrow illustration contrasts with the expanded pose; a sheath and delivery sequence are omitted.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "region_aorta": {
   "label": "AORTA",
   "body": "The aortic arch and the start of the descending aorta. The duct joins the underside of the arch where it turns down.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic",
   "landmarkId": "pda-occluders.aorta"
  },
  "region_pa_branch": {
   "label": "LEFT PULMONARY ARTERY",
   "body": "The left branch of the pulmonary artery runs backward from the top of the trunk. The duct leaves the pulmonary artery near the start of this branch.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_pa_trunk": {
   "label": "PULMONARY TRUNK",
   "body": "The main pulmonary artery rises in front of the aorta before it divides.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_duct": {
   "label": "ARTERIAL DUCT",
   "body": "A short vessel outside the heart joining the two great arteries, opened here to show its inside. Its course and size are representative and are not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic",
   "landmarkId": "pda-occluders.duct"
  },
  "region_device": {
   "label": "GENERIC DUCTAL PLUG",
   "body": "The generic plug fills the opened duct, with a retention rim at the aortic end. Its shape and size are representative and do not represent a specific product. Sealing and flow are not calculated.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  }
 },
