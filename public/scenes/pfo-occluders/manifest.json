 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "flap": {
   "label": "OVERLAPPING FLAPS",
   "body": "Two offset tissue flaps overlap here; this is a tunnel between layers, not a circular tissue deficiency.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "tunnel": {
   "label": "FLAP TUNNEL",
   "body": "The connector follows the representative passage between overlapping flaps. The tunnel is enlarged for legibility.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "disc": {
   "label": "RETENTION DISCS",
   "body": "Two expanded discs lie on opposing faces of the representative wall. These generic shapes do not represent a product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "compact": {
   "label": "COMPACT POSE",
   "body": "The narrow illustration contrasts with the expanded pose; a sheath and delivery sequence are omitted.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "region_RA": {
   "label": "RIGHT ATRIUM",
   "body": "The right atrium is opened from the right side. The two caval veins open into it above and below the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_LA": {
   "label": "LEFT ATRIUM",
   "body": "The left atrium lies behind the septum, seen here from outside with its lung veins.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_SVC": {
   "label": "UPPER CAVAL VEIN",
   "body": "The upper caval vein opens into the top of the right atrium, above the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_IVC": {
   "label": "LOWER CAVAL VEIN",
   "body": "The lower caval vein opens into the bottom of the right atrium, below the septum.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_septum": {
   "label": "INTERATRIAL SEPTUM",
   "body": "The back wall of the opened right atrium is the septum, shared with the left atrium. Around it the atrial walls fold away from each other, so the flat part of the septum is limited.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_communication": {
   "label": "OVERLAPPING FLAP TUNNEL",
   "body": "A slit-like passage runs obliquely through the septum. On the left atrial side a thin flap overlaps it, so from here the flap closes the view rather than a round hole. The position of the tunnel is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_device": {
   "label": "GENERIC OCCLUDER",
   "body": "One disc lies on the right atrial face, shown here, and a second disc lies on the left atrial side behind the septum and flap, joined through the tunnel. The device is sized to this site for the illustration and does not represent a specific product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  }
 },
