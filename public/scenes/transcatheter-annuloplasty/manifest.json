 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "junction": {
   "label": "MITRAL ANNULUS",
   "body": "The mitral annulus is the ring where the valve sits between the left atrium and left ventricle. This shape is schematic and representative.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "leaflets": {
   "label": "VALVE LEAFLETS",
   "body": "These representative surfaces illustrate leaflet relationships. The positions shown are representative; they are not measured or computed.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "ventricular_support": {
   "label": "PAPILLARY MUSCLES",
   "body": "Papillary muscles arise from the left ventricular wall and support the mitral leaflets through chordae. Their shapes are schematic.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "device": {
   "label": "GENERIC REPAIR DEVICE",
   "body": "The highlighted device and attachment shapes are representative of this class, not a specific product or a prediction.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "transcatheter-annuloplasty.device"
  },
  "region_atrium": {
   "label": "LEFT ATRIUM",
   "body": "The left atrium sits above the valve. Its shape comes from a real heart, opened along its long axis.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_ventricle": {
   "label": "LEFT VENTRICLE",
   "body": "The left ventricle sits below the valve. Its cavity and wall shape come from the same real heart.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_aorta": {
   "label": "AORTIC ROOT",
   "body": "The aortic root sits beside the front leaflet of the mitral valve and helps with orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_valve": {
   "label": "MITRAL VALVE",
   "body": "The two leaflets hang from the ring where the atrium joins the ventricle. Leaflet shape is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_support": {
   "label": "PAPILLARY MUSCLES",
   "body": "Two papillary muscles rise from the ventricular wall. Cords fan out from their tips to the leaflet edges. Their shapes are representative.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_device": {
   "label": "GENERIC PARTIAL BAND",
   "body": "The band sits on the atrial side of the ring where the leaflets attach. Its shape is representative, not a specific product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "transcatheter-annuloplasty.device"
  }
 },
