   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic",
   "landmarkId": "tricuspid-teer.device"
  },
  "region_atrium": {
   "label": "RIGHT ATRIUM",
   "body": "The right atrium sits above the valve. Its shape comes from a real heart, opened along its long axis.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_ventricle": {
   "label": "RIGHT VENTRICLE",
   "body": "The right ventricle sits below the valve. Its cavity and wall shape come from the same real heart.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_valve": {
   "label": "TRICUSPID VALVE",
   "body": "Three leaflets hang from the ring where the atrium joins the ventricle. Leaflet shape is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_support": {
   "label": "PAPILLARY MUSCLES",
   "body": "Two papillary muscles rise from the ventricular wall. Cords fan out from their tips to the leaflet edges. Their shapes are representative.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
