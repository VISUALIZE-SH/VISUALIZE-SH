   "label": "TRICUSPID VALVE",
   "body": "The tricuspid valve lies between the right atrium and right ventricle. Its depicted shape is schematic.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "leaflets": {
   "label": "VALVE LEAFLETS",
   "body": "These representative surfaces illustrate leaflet relationships. The positions shown are representative; they are not measured or computed.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "ventricular_support": {
   "label": "PAPILLARY MUSCLES",
   "body": "Papillary muscles arise from the ventricular wall and support the valve leaflets through chordae. Their shapes are schematic.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "device": {
   "label": "GENERIC REPAIR DEVICE",
