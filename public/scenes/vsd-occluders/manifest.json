 "annotations": {
  "location": {
   "label": "TREATMENT LOCATION",
   "body": "The highlighted region locates this class in the heart. The marker is enlarged for orientation.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "wall": {
   "label": "MUSCULAR SEPTUM",
   "body": "This thicker panel represents a muscular ventricular septal region; it does not depict a perimembranous defect or nearby conduction tissue.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "aperture": {
   "label": "TRUE APERTURE",
   "body": "This opening passes through the representative septal wall. The section reveals its continuous rim.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "waist": {
   "label": "CONNECTING WAIST",
   "body": "The narrow middle lies within the illustrated aperture between the two retention discs.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "disc": {
   "label": "RETENTION DISCS",
   "body": "Two expanded discs lie on opposing faces of the representative wall. These generic shapes do not represent a product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "compact": {
   "label": "COMPACT POSE",
   "body": "The narrow illustration contrasts with the expanded pose; a sheath and delivery sequence are omitted.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  },
  "region_RV": {
   "label": "RIGHT VENTRICLE",
   "body": "The right ventricle wraps around the septum as a crescent, seen here in cross-section.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_LV": {
   "label": "LEFT VENTRICLE",
   "body": "The left ventricle is the round chamber, seen here in cross-section with its thick wall.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_septum": {
   "label": "MUSCULAR VENTRICULAR SEPTUM",
   "body": "The thick muscular wall shared by the two ventricles. It is much thicker than the atrial septum, so the opening runs through it like a short channel.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_communication": {
   "label": "TRUE SEPTAL OPENING",
   "body": "A round opening runs through the muscular septum; the cut passes through it. Openings in other parts of the septum, near the valves, are not shown. The position of the opening is representative and is not measured on a specific patient or population.",
   "color": "#693387",
   "layer": "anatomy",
   "fidelity": "authored-schematic"
  },
  "region_device": {
   "label": "GENERIC OCCLUDER",
   "body": "One disc lies on the right ventricular face and a second disc on the left ventricular face, joined through the opening. The device is sized to this opening for the illustration and does not represent a specific product.",
   "color": "#ffd358",
   "layer": "device",
   "fidelity": "authored-schematic"
  }
 },
