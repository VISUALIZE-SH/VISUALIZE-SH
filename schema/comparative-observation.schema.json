{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://visualize-sh.org/schema/comparative-observation.schema.json",
  "title": "Structural-heart comparative observations",
  "description": "A source-located, configuration-aware comparison dataset. This schema validates record shape; use scripts/comparative-schema-validation.ts for collection-level identifier, applicability, module, and conflict-reference validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_configurations", "metric_definitions", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_configurations": { "type": "array", "items": { "$ref": "#/$defs/device_configuration" } },
    "metric_definitions": { "type": "array", "items": { "$ref": "#/$defs/metric_definition" } },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "minLength": 3, "maxLength": 160 },
    "non_empty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "format": "date" },
    "therapy_class": { "enum": ["TAVR", "TMVR", "TTVR", "M_TEER", "T_TEER", "LAAO", "ASD_occluder", "PFO_occluder", "annuloplasty", "CAVI", "other"] },
    "mechanism": { "enum": ["replacement", "leaflet_approximation", "leaflet_repair", "annular_remodeling", "single_seal_occlusion", "dual_seal_occlusion", "septal_occlusion", "other"] },
    "module": { "enum": ["core_device_card", "deployment_bench", "valve_bench_hydrodynamics", "clinical_valve_hemodynamics", "leaflet_repair_performance", "occlusion_sealing_performance", "procedural", "device_safety", "physiology_function", "durability_longitudinal", "clinical_outcome", "other"] },
    "device_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "product_version_id", "device_family_id", "generation", "configuration_label", "therapy_class", "target_structure", "mechanism"],
      "properties": {
        "configuration_id": { "$ref": "#/$defs/id" },
        "product_version_id": { "$ref": "#/$defs/id" },
        "device_family_id": { "$ref": "#/$defs/id" },
        "generation": { "$ref": "#/$defs/non_empty" },
        "configuration_label": { "$ref": "#/$defs/non_empty", "description": "Labeled size, model, or configuration; do not use the family name alone." },
        "therapy_class": { "$ref": "#/$defs/therapy_class" },
        "target_structure": { "$ref": "#/$defs/non_empty" },
        "mechanism": { "$ref": "#/$defs/mechanism" },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["route"],
          "properties": {
            "route": { "$ref": "#/$defs/non_empty" },
            "component": { "enum": ["delivery_capsule", "sheath", "introducer", "guide_catheter", "other"] },
            "profile_fr": { "type": "number", "exclusiveMinimum": 0 },
            "profile_definition": { "$ref": "#/$defs/non_empty" },
            "minimum_vessel_diameter_mm": { "type": "number", "exclusiveMinimum": 0 }
          },
          "allOf": [{ "if": { "required": ["profile_fr"] }, "then": { "required": ["component", "profile_definition"] } }]
        },
        "design": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frame_material": { "$ref": "#/$defs/non_empty" },
            "leaflet_material": { "$ref": "#/$defs/non_empty" },
            "leaflet_position": { "enum": ["supra_annular", "intra_annular", "none", "other"] },
            "anchor_mechanism": { "$ref": "#/$defs/non_empty" },
            "seal_design": { "$ref": "#/$defs/non_empty" },
            "retrievable": { "type": "boolean" },
            "repositionable": { "type": "boolean" }
          }
        },
        "labeled_anatomy_fit": { "type": "array", "items": { "$ref": "#/$defs/non_empty" } }
      }
    },
    "metric_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "display_name", "module", "value_kind", "applicable_to", "required_context", "default_comparability"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/id" },
        "display_name": { "$ref": "#/$defs/non_empty" },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty" } },
        "module": { "$ref": "#/$defs/module" },
        "value_kind": { "enum": ["numeric", "ordinal", "categorical", "boolean", "text"] },
        "canonical_unit": { "$ref": "#/$defs/non_empty" },
        "applicable_to": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/therapy_class" } },
        "required_context": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/non_empty" } },
        "default_comparability": { "enum": ["direct", "conditional", "within_family_only", "not_comparable"] },
        "definition_note": { "$ref": "#/$defs/non_empty" }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "protocol_or_grading_standard", "conditions_summary"],
      "properties": {
        "modality": { "enum": ["pulse_duplicator", "bench_fixture", "echocardiography", "TEE", "CT", "CMR", "angiography", "catheterization", "clinical_adjudication", "source_scope_review", "not_applicable", "other"] },
        "protocol_or_grading_standard": { "$ref": "#/$defs/non_empty" },
        "conditions_summary": { "$ref": "#/$defs/non_empty" },
        "conditions": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    },
    "timepoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "phase"],
      "properties": {
        "label": { "$ref": "#/$defs/non_empty" },
        "phase": { "enum": ["pre_deployment", "bench_test", "procedure", "baseline", "discharge", "follow_up", "event_window", "not_applicable", "other"] },
        "window_start": { "$ref": "#/$defs/non_empty" },
        "window_end": { "$ref": "#/$defs/non_empty" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setting", "target_structure", "anatomy_or_model", "cohort_or_sample"],
      "properties": {
        "setting": { "enum": ["bench", "procedural", "in_vivo", "not_applicable"] },
        "target_structure": { "$ref": "#/$defs/non_empty" },
        "anatomy_or_model": { "$ref": "#/$defs/non_empty" },
        "cohort_or_sample": { "$ref": "#/$defs/non_empty" },
        "configuration_context": { "$ref": "#/$defs/non_empty" },
        "event_definition": { "$ref": "#/$defs/non_empty" },
        "denominator": { "type": "integer", "minimum": 0 },
        "adjudication": { "$ref": "#/$defs/non_empty" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "url", "locator", "extracted_on", "review_status"],
      "properties": {
        "source_type": { "enum": ["FDA_SSED", "FDA_label", "primary_article", "comparative_review", "registry", "manufacturer", "other"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "locator": { "$ref": "#/$defs/non_empty" },
        "doi": { "$ref": "#/$defs/non_empty" },
        "pmid": { "$ref": "#/$defs/non_empty" },
        "pmcid": { "$ref": "#/$defs/non_empty" },
        "extracted_on": { "$ref": "#/$defs/date" },
        "review_status": { "enum": ["unreviewed", "verified", "published", "needs_resolution"] }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "configuration_id", "metric_id", "module", "measurement_status", "comparability", "comparability_rationale", "method", "timepoint", "context", "provenance"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "configuration_id": { "$ref": "#/$defs/id" },
        "metric_id": { "$ref": "#/$defs/id" },
        "module": { "$ref": "#/$defs/module" },
        "measurement_status": { "enum": ["reported", "tested_not_publicly_disclosed", "not_reported", "not_extracted", "not_applicable", "conflicting_sources"] },
        "value": { "type": ["number", "string", "boolean"] },
        "unit": { "$ref": "#/$defs/non_empty" },
        "statistic": { "enum": ["individual", "mean", "median", "proportion", "rate", "range", "threshold", "ordinal", "categorical", "qualitative"] },
        "dispersion": { "$ref": "#/$defs/non_empty" },
        "sample_size": { "type": "integer", "minimum": 0 },
        "conflict_observation_ids": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }, "description": "For conflicting_sources only: separate reported observations that disagree; values stay on those source observations." },
        "comparability": { "enum": ["direct", "conditional", "within_family_only", "not_comparable"] },
        "comparability_rationale": { "$ref": "#/$defs/non_empty" },
        "method": { "$ref": "#/$defs/method" },
        "timepoint": { "$ref": "#/$defs/timepoint" },
        "context": { "$ref": "#/$defs/context" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "measurement_status": { "const": "reported" } }, "required": ["measurement_status"] },
          "then": { "required": ["value", "unit", "statistic"] },
          "else": { "not": { "anyOf": [{ "required": ["value"] }, { "required": ["unit"] }, { "required": ["statistic"] }, { "required": ["dispersion"] }, { "required": ["sample_size"] }] } }
        },
        {
          "if": { "properties": { "measurement_status": { "const": "conflicting_sources" } }, "required": ["measurement_status"] },
          "then": { "required": ["conflict_observation_ids"] },
          "else": { "not": { "required": ["conflict_observation_ids"] } }
        },
        {
          "if": { "properties": { "statistic": { "enum": ["proportion", "rate"] } }, "required": ["statistic"] },
          "then": { "properties": { "context": { "required": ["denominator", "event_definition"] } } }
        },
        {
          "if": { "properties": { "context": { "properties": { "setting": { "const": "bench" } }, "required": ["setting"] } }, "required": ["context"] },
          "then": { "properties": { "method": { "properties": { "conditions": { "minProperties": 1 } }, "required": ["conditions"] } } }
        }
      ]
    }
  }
}
