{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "news.schema.json",
  "title": "News item",
  "description": "A concise, source-linked news item associated with one or more existing graph nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "publishedAt", "title", "summary", "sourceName", "sourceUrl", "topicTags", "relevantNodeIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^news-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "publishedAt": { "type": "string", "format": "date" },
    "title": { "type": "string", "minLength": 1, "maxLength": 220 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 650 },
    "sourceName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Canonical public HTTPS URL for the cited source." },
    "reviewStatus": { "type": "string", "enum": ["draft", "reviewed"], "description": "New automated research stays draft until a curator approves it for the public feed and newsletter." },
    "additionalSources": {
      "type": "array", "uniqueItems": true, "maxItems": 5,
      "description": "Independent or corroborating sources for the same event; never duplicate the primary URL.",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 100 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      }
    },
    "topicTags": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48 }
    },
    "relevantNodeIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(cond|rx|dev|dig|proc|co|trial)-[a-z0-9-]+$" }
    }
  }
}
